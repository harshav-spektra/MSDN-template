{
    "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
    "contentVersion": "1.0.0.0",

    "parameters": {
        "identityName": {
            "defaultValue": "quotaCheckIdentity",
            "type": "String"
        },
        "scriptUri": {
            "defaultValue": "https://experienceazure.blob.core.windows.net/templates/SQLAIAD/MS-Innovation/quota-check.ps1",
            "type": "String"
        }
    },

    "variables": {
        "readerRoleAssignmentId": "[guid(concat(resourceGroup().id, 'reader'))]",
        "cognitiveServicesUsagesReaderRoleAssignmentId": "[guid(concat(resourceGroup().id, 'cognitiveServicesUsagesReader'))]",

        "readerRoleDefinitionId": "[concat('/subscriptions/', subscription().subscriptionId, '/providers/Microsoft.Authorization/roleDefinitions/acdd72a7-3385-48ef-bd42-f606fba81ae7')]",

        "cognitiveServicesUsagesReaderRoleDefinitionId": "[concat('/subscriptions/', subscription().subscriptionId, '/providers/Microsoft.Authorization/roleDefinitions/bba48692-92b0-4667-a9ad-c31c7b334ac2')]"
    },

    "resources": [

        {
            "type": "Microsoft.ManagedIdentity/userAssignedIdentities",
            "apiVersion": "2018-11-30",
            "name": "[parameters('identityName')]",
            "location": "[resourceGroup().location]"
        },

        {
            "type": "Microsoft.Authorization/roleAssignments",
            "apiVersion": "2018-09-01-preview",
            "name": "[variables('readerRoleAssignmentId')]",
            "dependsOn": [
                "[resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', parameters('identityName'))]"
            ],
            "properties": {
                "roleDefinitionId": "[variables('readerRoleDefinitionId')]",
                "principalId": "[reference(resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', parameters('identityName')), '2018-11-30').principalId]",
                "scope": "[resourceGroup().id]",
                "principalType": "ServicePrincipal"
            }
        },

        {
            "type": "Microsoft.Authorization/roleAssignments",
            "apiVersion": "2018-09-01-preview",
            "name": "[variables('cognitiveServicesUsagesReaderRoleAssignmentId')]",
            "dependsOn": [
                "[resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', parameters('identityName'))]"
            ],
            "properties": {
                "roleDefinitionId": "[variables('cognitiveServicesUsagesReaderRoleDefinitionId')]",
                "principalId": "[reference(resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', parameters('identityName')), '2018-11-30').principalId]",
                "scope": "[resourceGroup().id]",
                "principalType": "ServicePrincipal"
            }
        },

        {
            "type": "Microsoft.Resources/deploymentScripts",
            "apiVersion": "2020-10-01",
            "name": "checkQuotaScript",
            "location": "[resourceGroup().location]",

            "dependsOn": [
                "[resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', parameters('identityName'))]",
                "[resourceId('Microsoft.Authorization/roleAssignments', variables('readerRoleAssignmentId'))]",
                "[resourceId('Microsoft.Authorization/roleAssignments', variables('cognitiveServicesUsagesReaderRoleAssignmentId'))]"
            ],

            "kind": "AzurePowerShell",

            "identity": {
                "type": "UserAssigned",
                "userAssignedIdentities": {
                    "[resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', parameters('identityName'))]": {}
                }
            },

            "properties": {
                "azPowerShellVersion": "10.4",
                "timeout": "PT15M",
                "cleanupPreference": "OnSuccess",
                "retentionInterval": "P1D",
                "primaryScriptUri": "[parameters('scriptUri')]"
            }
        }
    ],

    "outputs": {
        "gpt-5.1 Quota": {
            "type": "String",
            "value": "[reference('checkQuotaScript').outputs.availableLocations_gpt51]"
        },

        "text-embedding-3-small Quota": {
            "type": "String",
            "value": "[reference('checkQuotaScript').outputs.availableLocations_textembedding3small]"
        }
    }
}
